# Copiar este archivo como ".env" (en la carpeta backend) y ajustar los valores si hace falta.
# No subir nunca el archivo ".env" real al repositorio.

# Puerto donde escucha el servidor (los servicios de despliegue lo definen solos)
PORT=3000

# Archivo de la base de datos SQLite (se crea solo). Opcional.
# DB_FILE=./data/spatime.db

# Orígenes que pueden consultar la API por CORS, separados por comas. Opcional.
# Vacío = cualquier origen (suficiente para uso local).
# En el despliegue conviene poner la URL de la aplicación publicada.
# CORS_ORIGIN=https://spatime.onrender.com
